		extra_count = 5
		parts.Insert("NPCArea")
		if selected_area == "Residence" || selected_area == "StationFront" || selected_area == "Park"
			risk_poolHard1.Insert("(InLight,IsDayTime)")

	category_pool = CreateList("Risk","Gear","Pose","Face","Conflicting")
	if _settings.vip_requestAllowSets && _state.Rank > 2
		category_pool.Insert("CosplaySet")

	extra_picks = 0
	pickedPose = false
	pickedRisk = 0
	pickedRiskHard1=false
	pickedRiskHard2=false
	pickedCosplaySet = false
	pickedConflicting = false
	pickedGear = false
	pickedFace = false
	while extra_picks < extra_count
		if category_pool.Count() == 0
			extra_picks = extra_count
		else
			cat_idx = RandomInt(0, category_pool.Count())
			cat_name = category_pool[cat_idx]

			#Log("FC.VIP: Category = " + cat_name)

			category_pool.Remove(index=cat_idx)

			pool = null
			if cat_name == "Risk" && pickedRisk<=1
				if _settings.vip_requestHardMode && !pickedRiskHard1
					pool=risk_poolHard1
					pickedRiskHard1=true
				elseif _settings.vip_requestHardMode && !pickedRiskHard2
					pool=risk_poolHard2
					pickedRiskHard2=true
				else 
					if selected_area == "Park" || selected_area == "ShoppingMall"
						risk_pool.Insert("Sitting")
					pool = risk_pool
				pickedRisk +=1
			elseif cat_name == "Pose" && !pickedPose
				pickedPose = true
				pool = pose_pool
				if selected_area == "Residence" || selected_area == "Mansion" 
					pool.Insert("Action_Pinpon")
				if selected_area == "Residence" || selected_area == "StationFront"  || selected_area == "Park"
					pool.Insert("Action_UseBuyMachine") #note: BuyMachine in park conflicts with InOpenToilet, so it is omitted
			elseif cat_name == "CosplaySet" && !pickedCosplaySet && _state.Rank > 2
				pool = cosplayset_pool
				pickedCosplaySet = true
			elseif cat_name == "Face"
				pool = face_pool
				pickedFace = true
			elseif cat_name == "Conflicting" && !pickedConflicting 
				pool = conflicting_pool
				pickedConflicting = true
				if selected_area == "Park"
					pool.Insert("InOpenToilet")
			else
				if !pickedFace
					pool = face_pool
					pickedFace = true
				else
					pool = gear_pool # we allow multiple gear as fallback, but prefer other categories first

			cond = null
			if pool != null
				if pool.Count() > 0
					idx = RandomInt(0, pool.Count())
					cond = pool[idx]

			#Log("FC.VIP: Selected condition = " + cond)

			if cond != null && cond != "" && cond != "null"
				parts.Insert(cond)
				extra_picks = extra_picks + 1

	#Log("FC.VIP: === VIP DEBUG START ===")
	#Log("FC.VIP: Condition count = " + parts.Count())

	i = 0
	while i < parts.Count()
		part = parts[i]
		if part == null
			#Log("FC.VIP: Condition[" + i + "] = NULL")
		elseif part == ""
			#Log("FC.VIP: Condition[" + i + "] = EMPTY")
		elseif part == "null"
			#Log("FC.VIP: Condition[" + i + "] = STRING_NULL")
		else
			#Log("FC.VIP: Condition[" + i + "] = " + part)
		i += 1

	#Log("FC.VIP: === VIP DEBUG END ===")

	valid_parts = CreateList()
	i = 0
	while i < parts.Count()
		part = parts[i]
		if part != null && part != "" && part != "null"
			valid_parts.Insert(part)
		i += 1

	if valid_parts.Count() <= 0
		valid_parts.Insert("Exposed_Front")

	reward = 0
	part_count = valid_parts.Count()

	if part_count <= 1
		reward = vip_requestScore * _settings.vip_requestPartMultiplier
	elseif part_count == 2
		reward = vip_requestScore * (_settings.vip_requestPartMultiplier**2)
	elseif part_count == 3
		reward = vip_requestScore * (_settings.vip_requestPartMultiplier**3)
	else
		reward = vip_requestScore * (_settings.vip_requestPartMultiplier**4) 

	readable_text = ""

	i = 0
	while i < valid_parts.Count()
		part = valid_parts[i]

		if part == "HandcuffsBack" || part == "HandcuffsObject" || part == "ShowingOff" 
			reward = reward + 100
		elseif part == "NearNPC" || part == "(InLight,IsDayTime)" || part == "VibrationHigh" || part == "AdultToy_EyeMask,SubCondition_Vis_Face,SubCondition_Vis_High"
			reward = reward + 50
		elseif part == "SubCondition_Shibari,(SubCondition_Vis_Breast,SubCondition_Vis_Groin)" || part == "Action_GanimataWalk" || part == "Action_AhegaoDoublePiece" || part == "Action_HipShake" || part == "Action_GanimataHip" || part == "Action_KaikyakuFella" || part == "Action_Dogeza" || part == "Action_DogTintin" || part == "Action_IBalance" || part == "Action_WakimiseCrouch" || part == "Action_MituasiOnani" || part == "Action_Tebura" || part == "Action_PeeKaikyaku" || part == "Action_PeeDog" || part == "Action_ChikubiRotate" || part == "Action_OnaniYotuashi" || part == "Action_OnaniNeGanimata" || part == "Action_OnaniNormal" || part == "Action_NeKataashiage" || part == "Action_OnaniArmKuri" || part == "Action_GanimataKoshiHeko" || part == "Action_Haigure" || part == "Action_PeeStand"
			reward = reward + 50
		elseif part == "SubCondition_Exposed_Face" || part == "IsDayTime" #Face Reveal - no anonymity!
			reward = reward + 150
		elseif Find("tion_Face", part)  >= 0 # 
			reward = reward + 50
		elseif Find("Action_Use", part) >= 0  # Action_Use, includes all dildo
			reward = reward + 100
		elseif Find("AdultToy_", part) >= 0 # Pistons, vibrators etc not already found
			reward = reward + 25
		elseif Find("general_genital", part) >= 0 # Cosplay genitals: anal plugs etc
			reward = reward + 25
		elseif Find("_Set_", part)  >= 0 # Cosplay Sets
			reward = reward + 50
		elseif Find("Vibration", part) >= 0
			reward = reward + 25


		part_text = get_vip_part_text(part=part)

		#DumpVariable(part_text,4)

		if part_text != ""
			if readable_text == ""
				readable_text = part_text
			else
				readable_text = readable_text + " / " + part_text

		i += 1

	if readable_text == ""
		readable_text = Tx.VIP_Exposed_Front

	if valid_parts.Count() == 1
		vip_string = valid_parts[0]
	else
		vip_string = "["
		i = 0
		while i < valid_parts.Count()
			if i > 0
				vip_string = vip_string + ","
			vip_string = vip_string + valid_parts[i]
			i += 1
		vip_string = vip_string + "]"

	if vip_string == null
		vip_string = "Exposed_Front"
	if vip_string == ""
		vip_string = "Exposed_Front"
	if vip_string == "null"
		vip_string = "Exposed_Front"
	if GetType(vip_string) != "String"
		vip_string = "Exposed_Front"

	if reward == null
		reward = _settings.vip_requestScore

	#Log("FC.VIP: Generated VIP condition = " + vip_string)
	#Log("FC.VIP: Generated VIP text = " + readable_text)
	#Log("FC.VIP: Generated VIP reward = " + reward)
	#Log("FC.VIP: Final VIP condition = " + vip_string)
	#Log("FC.VIP: Final text = " + readable_text)
	#Log("FC.VIP: Final reward = " + reward)

	vipCondObj = CreateCondition(vip_string)
	_save.vip_request = vip_string
	_save.vip_request_text = readable_text
	_save.vip_request_reward = Min( _settings.vip_requestScore*(1+_state.Rank),  Ceil(reward * vipRewardScale) )
	_save.vip_request_active = true
	_save.vip_request_area = selected_area
	_save.vip_request_area_text = selected_area_text
	_result = vip_string


# -----------------------------------------
# 清除VIP
# -----------------------------------------
clear_vip_request:
	_save.vip_request = null
	_save.vip_request_text = ""
	_save.vip_request_reward = 0
	_save.vip_request_active = false
	_save.vip_request_area = ""
	_save.vip_request_area_text = ""
	vipCondObj = CreateCondition("[Exposed_All,Exposed_None]")

# -----------------------------------------
# 获取VIP文本（带区域）
# -----------------------------------------
get_vip_request_text:
	if Tx == null
		Tx = Global("FC.Tx")
	init_vip_system()

	if !has_valid_vip_request()
		if _save.vip_request_text != null && _save.vip_request_text != ""
			_result = Tx.VIP_RequestPrefix + _save.vip_request_text
		else
			_result = Tx.VIP_RequestPrefix + Tx.VIP_None
		return

	display_text = _save.vip_request_text
	if display_text == null || display_text == "" || display_text == "null"
		display_text = _save.vip_request

	area_text = _save.vip_request_area_text

	#Log("FC.VIP: Tx.VIP_RequestPrefix "+Tx.VIP_RequestPrefix)
	#Log("FC.VIP: display_text "+display_text)
	#Log("FC.VIP: Tx.VIP_AreaPrefix "+Tx.VIP_AreaPrefix)
	#Log("FC.VIP: Tx.VIP_AreaPrefix "+Tx.VIP_AreaPrefix)
	#Log("FC.VIP: area_text "+area_text)
	#Log("FC.VIP: Tx.VIP_AreaSuffix "+Tx.VIP_AreaSuffix)
	#Log("FC.VIP: _save.vip_request_reward "+_save.vip_request_reward)

	if area_text != null && area_text != "" && area_text != "null"
		_result = Tx.VIP_RequestPrefix + display_text + Tx.VIP_AreaPrefix + area_text + Tx.VIP_AreaSuffix + " [RP +" + _save.vip_request_reward + "]"
	else
		_result = Tx.VIP_RequestPrefix + display_text + " [RP +" + _save.vip_request_reward + "]"


# -----------------------------------------
# VIP条件检测（含区域）
# -----------------------------------------
vip_check_current:
	if Tx == null
		Tx = Global("FC.Tx")
	init_vip_system()


	if !has_valid_vip_request()
		_result = false
		return

	vipcond = _save.vip_request
	#Log("FC.VIP: vip_check_current condition = " + vipcond)

	if vipcond == null
		clear_vip_request()
		_result = false
		return

	if GetType(vipcond) != "String"
		clear_vip_request()
		_result = false
		return

	if vipcond == "" || vipcond == "null"
		clear_vip_request()
		_result = false
		return

	## There is a strange bug with the condition. I hope this helps 
	if vipCondObj.Check() == false 
		vipCondObj = CreateCondition(vipcond)

	if vipCondObj == null
		#Log("FC.VIP: CreateCondition failed: " + vipcond)
		clear_vip_request()
		_result = false
		return

	ok = vipCondObj.Check()
	#Log("FC.VIP: vipCondObj.Check() = " + ok)
	area_ok = true

	req_area = _save.vip_request_area
	cur_area = null

	if _state != null && _state.Position != null
		cur_area = _state.Position.stage

	if req_area != null && req_area != "" && req_area != "null"
		if cur_area == null
			area_ok = false
		elseif Find(req_area, cur_area) < 0
			#Log("FC.VIP: VIP area mismatch: " + cur_area + " vs " + req_area)
			area_ok = false

	_result = ok && area_ok


# -----------------------------------------
# 应用VIP结果
# -----------------------------------------
apply_vip_current_result:
	if Tx == null
		Tx = Global("FC.Tx")

	ok = vip_check_current() && conVisible.Check()
	cVis = Min(1, ConditionVisibility(_save.vip_request) * 1.5 )
	# #Log("FC.VIP: > VIP cVis : " + cVis)

	if ok && cVis > 0.5
		mp_focus.SetVisible(false)
		reward = _save.vip_request_reward
		if reward == null
			reward = vip_requestScore * vipRewardScale

		arisk = (_state.Detection+_state.RpBonus)/2
		if useAbstractRisk
			reward *= arisk

		scoreVis = Max(0.5, cVis)
		reward *= scoreVis

		fans_hype += scoreVis/vip_requestScore*_settings.fans_bumpScale
		if useAbstractRisk
			fans_hype*=arisk

		#Log("FC.VIP: Request COMPLETE! Final RP: " + reward  +", Visibility: " + cVis)
		AddCurrentEarnRP( Ceil(reward) )
		clear_vip_request()
		_result = true
	else
		#Log("FC.VIP: Request FAILED! con:" + ok  +", cVis:" + cVis)
		_result = false
