		pose_pool.Insert("SubCondition_Action_SwitchP")
		gear_pool.Insert("AdultToy_PistonPussy,(SubCondition_Vis_Groin,SubCondition_Vis_High)","AdultToy_PistonAnal,(SubCondition_Vis_Groin,SubCondition_Vis_High)")
