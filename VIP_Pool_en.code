# =========================================
# VIP 随机条件系统（动态RP显示版）
# =========================================

# Local Var
vipCondObj = CreateCondition("[Exposed_All,Exposed_None]")
mp_focus = CreateMissionPanel()
mp_focus.SetText("VIP Camera Focus")
mp_focus.SetVisible(false)
mp_focus.SetGaugeProgress(0)
focusTimer=0

# -----------------------------------------
# VIP Request Condition Focus Meter!
# -----------------------------------------
vip_focus_meter:
	if _save.vip_request_active && !conNone.Check()
		if focusTimer == null
			focusTimer=0

		focusTimer = focusTimer + _timediff
		if focusTimer > 0.01
			focusTimer = 0
			if vipCondObj != null && vipCondObj.Check() && _save.vip_request != null && _save.vip_request!=""
				cVis = Min(1, ConditionVisibility(_save.vip_request) * 1.5 )
				mp_focus.SetVisible(true)
				mp_focus.SetGaugeVisible(true)
				mp_focus.SetText("VIP Camera Focus")
				gauge = mp_focus.GetGaugeProgress()
				gauge = lerp(gauge,Max(0,cVis),0.3)
				mp_focus.SetGaugeProgress( Max(0,cVis) )
				if debugInput.IsPressed()
			else
				if !vipCondObj.Check()
					mp_focus.SetVisible(false)

	if conNone.Check()
		mp_focus.SetVisible(false)

if vipFocussing == null
	mp_focus = CreateMissionPanel()
	mp_focus.SetGaugeVisible(true)
	mp_focus.SetVisible(false)
	mp_focus.SetGaugeProgress(0)
	vipFocussing = CreateListener("vip_focus_meter")

# -----------------------------------------
# 文本函数
# -----------------------------------------
get_area_text:
	if Tx == null
		Tx = Global("FC.Tx")

	if area == "Convenience"
		_result = Tx.Area_Convenience
	elseif area == "FashionShop"
		_result = Tx.Area_FashionShop
	elseif area == "Residence"
		_result = Tx.Area_Residence
	elseif area == "ShoppingMall"
		_result = Tx.Area_ShoppingMall
	elseif area == "StationFront"
		_result = Tx.Area_StationFront
	elseif area == "Park"
		_result = Tx.Area_Park
	elseif area == "Mansion"
		_result = Tx.Area_Mansion
	else
		_result = area

get_vip_part_text:
	if Tx == null
		Tx = Global("FC.Tx")

	# Expose Pool
	if part == "Exposed_Front"
		_result = Tx.VIP_Exposed_Front
	elseif part == "Exposed_Hip"
		_result = Tx.VIP_Exposed_Hip
	elseif part == "Exposed_Upper"
		_result = Tx.VIP_Exposed_Upper
	elseif part == "(Exposed_All,SubCondition_Vis_Naked)"
		_result = Tx.VIP_Exposed_All
	elseif part == "!Exposed_None"
		_result = Tx.VIP_Exposed_Any

	# Risk Pool
	elseif part == "NearNPC"
		_result = Tx.VIP_NearNPC
	elseif part == "Watched,SubCondition_Vis_NPC"
		_result = Tx.VIP_Watched
	elseif part == "ShowingOff,SubCondition_Vis_NPC"
		_result = Tx.VIP_ShowingOff
	elseif part == "NPCArea"
		_result = Tx.VIP_NPCArea
	elseif part == "Peeing"
		_result = Tx.VIP_Peeing
	elseif part == "Orgasm"
		_result = Tx.VIP_Orgasm
	elseif part == "VibrationLow"
		_result = Tx.VIP_VibrationLow
	elseif part == "VibrationHigh"
		_result = Tx.VIP_VibrationHigh
	elseif part == "!Skill_Slow,!Skill_TimeStop"
		_result = Tx.VIP_Skill_Realtime

	#Gear Pool
	elseif part == "AdultToy_EyeMask,SubCondition_Vis_Face,SubCondition_Vis_High"
		_result = Tx.VIP_AdultToy_EyeMask
	elseif part == "AdultToy_Vibrator,SubCondition_Vis_Groin"
		_result = Tx.VIP_AdultToy_Vibrator
	elseif part == "AdultToy_KuriRotor,SubCondition_Vis_Groin"
