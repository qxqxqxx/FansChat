# -----------------------------------------
# 初始化 / 修复持久化数据
# -----------------------------------------
init_vip_system:
	if Tx == null
		Tx = Global("FC.Tx")

	if _save.vip_request_reward == null
		_save.vip_request_reward = 0
	if _save.vip_request_active == null
		_save.vip_request_active = false
	if _save.vip_request_text == null
		_save.vip_request_text = ""

	if _save.vip_request_area == null
		_save.vip_request_area = ""
	if _save.vip_request_area_text == null
		_save.vip_request_area_text = ""

	if _save.vip_request != null
		if GetType(_save.vip_request) != "String"
			_save.vip_request = null
			_save.vip_request_text = ""
			_save.vip_request_active = false
			_save.vip_request_reward = 0
			_save.vip_request_area = ""
			_save.vip_request_area_text = ""
		elseif _save.vip_request == "" || _save.vip_request == "null"
			_save.vip_request = null
			_save.vip_request_text = ""
			_save.vip_request_active = false
			_save.vip_request_reward = 0
			_save.vip_request_area = ""
			_save.vip_request_area_text = ""
		else
			vipCondObj = CreateCondition(_save.vip_request)

	if _save.vip_request_active
		if _save.vip_request == null
			_save.vip_request_active = false
			_save.vip_request_text = ""
			_save.vip_request_reward = 0
			_save.vip_request_area = ""
			_save.vip_request_area_text = ""
		elseif GetType(_save.vip_request) != "String"
			_save.vip_request = null
			_save.vip_request_active = false
			_save.vip_request_text = ""
			_save.vip_request_reward = 0
			_save.vip_request_area = ""
			_save.vip_request_area_text = ""
		elseif _save.vip_request == "" || _save.vip_request == "null"
			_save.vip_request = null
			_save.vip_request_active = false
			_save.vip_request_text = ""
			_save.vip_request_reward = 0
			_save.vip_request_area = ""
			_save.vip_request_area_text = ""
		else
			vipCondObj = CreateCondition(_save.vip_request)

	if _save.vip_request_reward == null
		_save.vip_request_reward = 0

	if _save.vip_request_text == null || _save.vip_request_text == "null"
		_save.vip_request_text = ""

	if _save.vip_request_area == null || _save.vip_request_area == "null"
		_save.vip_request_area = ""

	if _save.vip_request_area_text == null || _save.vip_request_area_text == "null"
		_save.vip_request_area_text = ""


# -----------------------------------------
# 清理当前VIP请求是否合法
# -----------------------------------------
sanitize_vip_request:
	if Tx == null
		Tx = Global("FC.Tx")
	init_vip_system()

	if _save.vip_request == null
		_result = false
		return

	if GetType(_save.vip_request) != "String"
		clear_vip_request()
		_result = false
		return

	if _save.vip_request == "" || _save.vip_request == "null"
		clear_vip_request()
		_result = false
		return

	_result = true


# -----------------------------------------
# 对外：按需刷新VIP请求
# -----------------------------------------
vipRequestChance = _settings.vip_RequestChance

refresh_vip_request:
	if Tx == null
		Tx = Global("FC.Tx")
	init_vip_system()

	#Log("FC.VIP: Refresh: enter")
	#Log(_save.vip_request_active)
	#Log(_save.vip_request)

	if has_valid_vip_request()
		#Log("FC.VIP: Refresh: keeping current request")
		#Log(_save.vip_request)
		_result = false

	elseif Random() >= vipRequestChance
		#Log("FC.VIP: Refresh: rolling VIP chance")

		_save.vip_request = null
		_save.vip_request_text = Tx.VIP_None
		_save.vip_request_reward = 0
		_save.vip_request_area = ""
		_save.vip_request_area_text = ""
		_save.vip_request_active = false
		vipCondObj = CreateCondition("[Exposed_All,Exposed_None]")

		#Log("FC.VIP: Refresh: no request rolled")
		_result = false

	else
		#Log("FC.VIP: Refresh: rolling VIP chance")
		#Log("FC.VIP: Refresh: roll success")

		generate_vip_request()

		#Log("FC.VIP: Refresh: generation complete")
		#Log(_save.vip_request)
		#Log(_save.vip_request_active)

		if _save.vip_request_active && _save.vip_request != null && _save.vip_request != "" && _save.vip_request != "null"
			#Log("FC.VIP: Refresh: new request generated")
			#Log(_save.vip_request)
			vipCondObj = CreateCondition(_save.vip_request)
			_result = true
		else
			#Log("FC.VIP: Refresh: generation failed, using default")
			_save.vip_request = "Exposed_Front"
			_save.vip_request_text = Tx.VIP_Exposed_Front
			_save.vip_request_reward = vip_requestScore
			_save.vip_request_area = "Residence"
			_save.vip_request_area_text = Tx.Area_Residence
			_save.vip_request_active = true
			vipCondObj = CreateCondition(_save.vip_request)
			_result = true


has_valid_vip_request:
	if !_save.vip_request_active
		_result = false
	elseif _save.vip_request == null
		_result = false
	elseif _save.vip_request == ""
		_result = false
	elseif _save.vip_request == "null"
		_result = false
	else
		_result = true


# -----------------------------------------
# 生成新的VIP请求
# -----------------------------------------
generate_vip_request:
	if Tx == null
		Tx = Global("FC.Tx")
	init_vip_system()

	expose_pool = CreateList("Exposed_Front")
	risk_pool = CreateList("NearNPC","ShowingOff","NPCArea","Peeing")
	gear_pool = CreateList("Cosplay_m_cosplay_general_genital_anal_plug,SubCondition_Vis_Groin")
	pose_pool = CreateList("Crouching","Action_PeeKaikyaku","Action_IBalance","Action_Dogeza","Action_OnaniNormal","Action_KaikyakuFella")
