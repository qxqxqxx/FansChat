## CONDITION REWARDS 
# wip v0.83
# originally for FansChat by eicosa, but you may use it for anything you want
# At the bottom of this file is a big set of manually defined 'hard coded' subconditions intended for use only within FansChat.
# But you may want to check:
# DefaultScoreTable - all the conditions and their reward/penalty
# ConditionsToSnapshotData - main logic for checking the visibility of all conditions

#--------------------
##  Visibiliy System
#--------------------
# Visibility ratings range from 0 to 1, and are calculated for every True condition.
# Visibility Bonuses and penalties add together, then multiply all visibility gains.
# If the sum of these is positive, it may
# - Widen the allowed 'facing' angle threshold
# - Allow body regions to count as 'in focus' when they might otherwise be out of view
# - Tip over a failed checked into passing
visUpperBonus= 0.33 # Exposed_Upper visibility should be a very wide arc around the front of manaka
visNudityBonus=0.2 # overall visibility bonus when fully naked (conNaked "SubCondition_Vis_Naked")
visPoseBonus=0.3 # visibility bonus when manaka is 'most likely' doing a pose, and possibly other actions.
visMedBonus=0.4 # cosplays that slightly protrude from from Manaka's silhouette
visHighBonus=0.5 # cosplays that are visible from almost any camera angle / exposure
visNegPenalty=0.1 # cosplays that make conditions harder to identify

# This penalty not combined with the above. It's directly subtracted when a Exposed_ condition fails a visibility check.
# Raising this value makes multi-exposure conditions like (Exposed_Hip,Exposed_Upper) rate similar to AND logic, requiring both checks to score high. Lowever values work like OR logic, requiring only one check to score high.
# eg. when camera is behind Manaka, a condition with "Exposed_Front" has visibility -= visFlatPenalty.
visFlatPenalty=0.3

# When "Hides_Breast" is found, this will multiply against all subsequent checks in visibility, and against Vis_Breast for score.
visModHidden=0.5

# DefaultScoreTable
# A set of default conditions and their RP scores (or penalties) 
# See also: MakeScoreTable, ConditionsToSnapshotData, ScoreSnapshotData
# You can override the RP values, or add new ones, with AppendScoreTable
