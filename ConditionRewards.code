	table = AppendScoreTable(table, "[SubCondition_Set_Succubus,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 60,"Succubus Cosplay")
	table = AppendScoreTable(table, "[SubCondition_Set_TacticalMaid,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 100,"Maid Cosplay")
	table = AppendScoreTable(table, "[SubCondition_Set_Ninja,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 50,"Ninja Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Sister,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 110,"Sister Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Furry,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 40,"Furry Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Bunny ,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 80,"Bunny Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Pony,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 50,"Latex Pony Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Jumpsuit,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 20,"Jumpsuit Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Guard,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 60,"Guard Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_Cowgirl ,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 70,"Cowgirl Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_WildBeast,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 70,"Wild Beast Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_SuitA,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 80,"Officewear Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_SuitB,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 50,"Officewear Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_AdultSweater,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 40,"Adult Sweater Cosplay") 
	table = AppendScoreTable(table, "[SubCondition_Set_DownJacket,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 30,"Down Jacket Cosplay")  
	table = AppendScoreTable(table, "[SubCondition_Set_SchoolUniformA,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 50,"School Cosplay A")  
	table = AppendScoreTable(table, "[SubCondition_Set_SchoolUniformB,(Exposed_Front,Exposed_Upper,Exposed_Hip),(Orgasm,!Action_None,SubCondition_Vis_Pose,ShowingOff),SubCondition_Vis_High]", 50,"School Cosplay B")  

	##DumpVariable(table,8)
	_result = table

# MakeScoreTable
# includes an indexable array reference for iterating through.
# examples: 
#	if table["InOpenToilet"].co.Check() && table.array[0]
#		score = table["InOpenToilet"].rp 

MakeScoreTable:
	#Log("FC.CR: > MakeScoreTable ")

	table = CreateList()
	table.array = CreateList()

	# Default condition for testing etc: Nudity! The RP is low because it stacks with other exposure rewards
	table[ "[CoatDropped,Exposed_All]"] = CreateList()
	table[ "[CoatDropped,Exposed_All]"].name = "[CoatDropped,Exposed_All]" # copy of the string name useful for logging, UI, etc
	table[ "[CoatDropped,Exposed_All]"].rp = 50 # rp score! Balance here!
	table[ "[CoatDropped,Exposed_All]"].index =  table.array.Count() # if we already know the index, it avoids skimming the array later if RP value needs to be adjusted in runtime
	table[ "[CoatDropped,Exposed_All]"].co = CreateCondition("[CoatDropped,Exposed_All]", table.array.Count() )  # condition ID = index. might be useful idk
	table[ "[CoatDropped,Exposed_All]"].guiName = "Coat Dropped"
	table.array.Insert( table["[CoatDropped,Exposed_All]"] ) # indexing this condition to the end of the array

	#Log("FC.CR: > MakeScoreTable exit")
	_result = table

# AppendScoreTable(t=scoreTable, c="condition string", rp=rp_score, [,guiName="Nice string for menus."])
AppendScoreTable:
	if t == null
		t = _args[0]
	if c == null
		c = _args[1]
	if rp == null
		rp = _args[2]
	if guiName == null
		guiName = _args[3]
	#Log("FC.CR: > AppendScoreTable : " + c) 

	if t[c] != null
		#Log("FC.CR: !AppendScoreTable : Already exists : "+ t[c].name +" : "+ c)
		t[c].rp = rp 
	else
		t[c] = CreateList()
		t[c].name = c
		if guiName != null
			t[c].guiName = guiName
			#Log("FC.CR: t[c].guiName : " + t[c].guiName)
		t[c].rp = rp 
		t[c].index = t.array.Count() 
		t[c].co = CreateCondition(c, t.array.Count()) 
		t.array.Insert( t[ c])
	#Log("FC.CR:  < AppendScoreTable Count : " + t.array.Count() )
	_result = t

OutputScoreTableNames:
	if t == null
		t = _args[0]

	out = CreateList()
	i = scoreTable.array.Count()-1
	while i>=0
		out.Insert(scoreTable.array[i].name)
		i-=1

	_result = out

# ScoreSnapshotData( cssd, sTable)
# Add up the rp bonus/penalties from the photo (cssd) 
ScoreSnapshotData:
	thread = _this
	if sTable == null
		Log("FC.CR: ! Warning : ScoreSnapshotData : sTable null !")
		sTable = _args[0]
	if cssd == null
		cssd = _args[1]

	out = CreateList()
	out["rp"] = 0
	out["best"] = ""
	rp = 0
	highestScore = 0
	highestName = "" 
	_result = 0

	# Log("FC.CR: > ScoreSnapshotData starting: ")
	# Do score. But not if photo is at home!
	if Find(cssd.Position.stage, "Apart") == -1 && cssd.Conditions.name.Count()>0
		#Log("FC.CR: ScoreSnapshotData > Starting score tally... ")
		i = cssd.Conditions.name.Count()-1

		while i>=0
			#Log(i)
			# Log("FC.CR:  < Condition found: " + cssd.Conditions.name[i])
			#if cssd.Conditions.state[i] #Manaka's complete _state from when photo was taken
			vis = Max(0, cssd.Conditions.visibility[i]) 
			# Log("FC.CR: vis " + vis)
			if vis > 0
				#Log("FC.CR: vis > 0  : "+ cssd.Conditions.name[i])
				basis = sTable[ cssd.Conditions.name[i] ].rp # Lookup the condition reward
				if basis > highestScore
					#Log("FC.CR: basis > highestScore  : "+ cssd.Conditions.name[i])
					highestScore = Max(highestScore,basis)
					highestName = cssd.Conditions.name[i]
					#Log("FC.CR: highestName : "+highestName)
					if sTable[cssd.Conditions.name[i]].guiName!=null
						highestName = sTable[cssd.Conditions.name[i]].guiName
						Log("FC.CR: sTable highest name : "+highestName)
					else
						Log("FC.CR: sTable name not found : "+cssd.Conditions.name[i])
						#Log ("sTable name not found : "+sTable[cssd.Conditions.name[i]].guiName)
				rp +=  Round(basis * vis)
				Log("FC.CR:  < Score added: "+ cssd.Conditions.name[i] +" : "+ Round( (sTable[ cssd.Conditions.name[i] ].rp * vis)) )
			i-=1
		#nothing, just early exit
		exit:
			#Log("FC.CR: ScoreSnapshotData > Finished scoring : " + rp)	
			_result = rp
		#Log("FC.CR: ScoreSnapshotData > Finished scoring : " + rp)

	# NPC score
	npcScore = 0 
	npcInView = CreateList()
	i = cssd.NPCs.Count()
	while i > 0
		i -= 1

		npc = Copy(cssd.NPCs[i],deepCopy=true)
		focus = InFocus_NPC(npc, cssd.Camera)
		npc.InFocus=focus
		if focus > 0
			npcInView.Insert(npc)
			Log("FC.CR: NPC is in photo : " )
			#DumpVariable(npc.State,1)

	i = npcInView.Count()
	while i > 0
		i -= 1
		npc = npcInView[i]
		npc_id = npc.ID

		npcScore+=1 # for just being in photo
		if npc.SeesPlayer
			npcScore+=1
		if npc.SeesFlashing
			npcScore+=1

	Log("FC.CR: npcScore : " + npcScore)
	out.npcScore = npcScore
	out.highestName = highestName
	out.highestScore = highestScore
	out.rp = rp	
	_result = out

NpcVis: # npcList, camera
	if _args[0] == null
		npcList = Copy(_state.NPCs,deepCopy=true)
	if _args[1] == null
		camera = _state.Camera

	out = CreateList()
	out.sumFocus = 0.0
	out.highestFocus = -1.0
	out.highestNpc = CreateList()

	i = npcList.Count()
	while i > 0
		i -= 1
		npc = Copy(npcList[i],deepCopy=true)
		focus = InFocus_NPC(npc, camera)
		out.sumFocus += focus
		if focus > out.highestFocus
			out.highestFocus = focus
			out.highestNpc = npc
	_result = out

ConditionsToSnapshotData:
	thread = _this
	if ssd == null
		ssd = _args[0]
	if ssd == null
		Log("FC.CR: Error : ConditionsToSnapshotData : ssd null")
		thread.Goto("exit")
	if sTable == null
		sTable = _args[1]
	if sTable == null
		Log("FC.CR: Error : ConditionsToSnapshotData : sTable null")
		thread.Goto("exit")	
	if state == null
		if _args[3]==null
			state = _state
		else
			state = _args[3]
	if requireExposure == null
		requireExposure = False
		exposed = False

	elseif requireExposure
		exposed = conExposedAny.Check()

	#Log("FC.CR: > Starting ConditionsToSnapshotData") 
	out = Copy(ssd, deepCopy = true)
	out.Conditions = CreateList()
	out.Conditions.name = CreateList()
	out.Conditions.dict = CreateList()
	out.Conditions.visibility = CreateList()
	out.State = _state # Manaka's full state from when photo was taken, because gallery does not keep entire state, and gallery is harder to implement
	if out.NPCs == null
		out.NPCs = _state.NPCs
	if out.Camera == null
		out.Camera = _state.Camera
	if out.CameraTarget == null
		out.CameraTarget = _state.CameraTarget
	if out.Position == null
		out.Position = _state.Position

	tVis=0 #total visibility of all conditions in the photo, only used for analytics/logging

	if requireExposure && !exposed
		Log("FC.CR: ConditionsToSnapshotData : exposure required, but not exposing!")
		i=-1 # Early exit : requireExposure parameter used, but Manaka not 'Exposed'
	elseif conFP.Check()
		Log("FC.CR: ConditionsToSnapshotData : First person camera used, exiting!")
		i=-1 # Early exit : FP Camera
	else
		i = sTable.array.Count()-1 # Proceed to Condition and Visibilty checks


	chestMod = 1 # visibility adjustments for subsequent conditions
	hipMod = 1
	while i>=0
		vis=0

		if sTable.array[i].co.Check()
			vis = ConditionVisibility(sTable.array[i].name)

		if vis > 0
			out.Conditions.name.Insert( sTable.array[i].name )
			out.Conditions.visibility.Insert( vis ) 
			out.Conditions.dict[sTable.array[i].name] = vis

		tVis+=vis

		i-=1
	exit:
		_result = null
	Log("FC.CR: ConditionsToSnapshotData > Finished : Total visibility= " + tVis) 
	##DumpVariable(out.Conditions, 8)
	_result = out


#ConditionVisibility( conString )
ConditionVisibility: # conString [, modHip,modChest]
	if conString == null
		conString = _args[0]
	if modHip == null
		modHip = _args[1]
	if modHip == null
		modHip = 1
	if modChest == null
		modChest = _args[2]
	if modChest == null
		modChest = 1

	# Check 1: Did this function call require preliminary exposure screening?
	# Check 2: Is each condition true on its own?
	# Check 3: If that condition requires specific exposure, check that it is visible in camera.
	# Keep in mind that we do not check for ! in the strings, so complicated or oddly specific conditions may be omitted erroneously
	cVis = 0 # Visibility Rating tally
	cNotVis = 0 # the flat penalty for visibility failure is tallied here, then subtracted in final stage
	cBonus = 1 # add stackable bonus/penalties to here - multiplier to visbility ratings
	cAngleBonus = 0 # add stackable bonus/penalties to here - subtracts from Facing Threshold, and reduces minimum allowed focus rating below 0
	if conCosplayNeg.Check() # the 'global' penalty from concealing cosplay items that will affect the entire photo
		cNotVis+=visNegPenalty

	# Log("FC.CR: ConditionVisibility >> " + conString )

	npcVis = CreateList()
	npcVis.focus = 1.0
	if Find("Vis_NPC", conString) >= 0
		npcVisCheck = NpcVis()
		npcVis.focus = npcVisCheck.sumFocus
		if npcVis.focus>0
			Log("FC.CR: NPC in frame!" + npcVis.focus)
		else
		 	Log("FC.CR: Vis_NPC, but no NPC in frame")

	if Find("Expos", conString) >= 0 || Find("Vis_", conString) >= 0 # If the condition includes Expose requirement, even if Exposed_None, process all visibility
		# Visibility Angle bonus/penalties
		if conNaked.Check()
			cBonus+=visNudityBonus
		if Find("Vis_Med", conString) >= 0
			cBonus+=visMedBonus
		if Find("Vis_High", conString) >= 0
			cBonus+=visHighBonus


		#Log("FC.CR:  < cBonus : " + cBonus)0
		cAngleBonus=cBonus-1 # because cAngleBonus should default as 0, if cBonus is 1.2, the angle bonus should be 0.2
		# Log("FC.CR:  < cAngleBonus : " + cAngleBonus)
		# Log("FC.CR:  < viewThresholds.front : " + viewThresholds.front)
		modifiedFacingThreshold = viewThresholds.front - cAngleBonus # The facing threshold gets easier to pass if visibility bonus is high. It is allowed to go negative, so some conditions that normally only visible in front can now be visible from side or even behind
		# Log("FC.CR:  < modifiedFacingThreshold : " + modifiedFacingThreshold)
		# Log("FC.CR:  < cAngleBonus : " + cAngleBonus)

		taggedAny = Max(0,Find("Exposed_Any", conString), Find("!Exposed_None", conString))

		taggedPoseNaked = Max(0,Find("_Vis_Naked", conString))
		taggedPoseNaked += Max(0,Find("_Vis_Pose", conString))

		taggedHipCrouch = Max(0,Find("_HipCrouch", conString))
		taggedHipCrouch += Max(0,Find("_Vis_Groin", conString))
		taggedHipCrouch += taggedPoseNaked + taggedAny

		taggedHip = taggedHipCrouch
		taggedHip += Max(0,Find("_Hip", conString))

		taggedUpper = Max(0,Find("_Upper", conString))
		taggedUpper += Max(0,Find("_Vis_Pose", conString))
		taggedUpper +=  taggedAny

		taggedFront = Max(0,Find("_Front", conString))
		taggedFront += Max(0,Find("_Vis_Breast", conString))
		taggedFront += taggedAny

		taggedFuta = Max(0,Find("Futa", conString))
		# Log("FC.CR: Tagged Futa")

		# Visibility Front
		front = viewCurrent.front*modChest
		# Log("FC.CR: front:"+front)
		if front > -modifiedFacingThreshold # negative facing = towards camera! Unlike other checks, cutoff is not pre-applied to viewCurrent.front during updates
			# Log("FC.CR:  < Facing camera, checking : _Front")
			if taggedFront > 0 # Checks if required anatomy is in view (Expose_Front)
				vis =Max( viewCurrent.front, viewCurrent.body )*cBonus#Front Vis: determine entirely by how directly she is facing camera
				cVis=Max(vis,cVis)
				# Log("FC.CR:  << Visible : _Front : " + viewCurrent.front)

				# Visibility Futa
				if taggedFuta > 0
					vis=Min(viewCurrent.crotch,viewCurrent.front)*2*cBonus
					cVis=Max(vis,cVis)
		else
			if taggedFront > 0  # Checks if required anatomy is in view (Expose_Front)
				cNotVis+=visFlatPenalty
				# Log("FC.CR:  << Not Visible, facing wrong way : _Front : " + viewCurrent.front)
			# Log("FC.CR:  < Facing away, skipped : _Front")


		# Visibility Upper
		upper = Max( viewCurrent.face, viewCurrent.body, viewCurrent.front) - ( Max(0,viewCurrent.crotch)/2)
		# Log("FC.CR:  upper : " + upper)
		if upper > (-cAngleBonus - visUpperBonus)
			# Log("FC.CR:  < Upper Focus, checking : _Upper")
			if taggedUpper > 0 # Checks if required anatomy is in view (Exposed_Upper)
				vis=upper*cBonus # Upper Vis: Highest out of Head or Body focus.
				cVis=Max(vis,cVis)
				# Log("FC.CR:  << Visible : _Upper : " + viewCurrent.body)
		else
			if taggedUpper > 0 # Checks if required anatomy is in view (Exposed_Upper)
				cNotVis+=visFlatPenalty
				# Log("FC.CR:  << Not in focus : _Upper : " + viewCurrent.body)

		# Visibility HipCrouch / Hip. Because "Hip" is included in "HipCrouch", rule-out hipcrouch first
		crotch = viewCurrent.crotch
		if taggedPoseNaked > 0
			crotch+=visPoseBonus
		crotch *= modHip
		# Log("FC.CR: crotch:"+crotch)
		if crotch > -cAngleBonus
			# Log("FC.CR:  < Crotch Focus, checking facing : _HipCrouch and _Hip")
			# HipCrouch
			if ManakaDotCamera() < modifiedFacingThreshold # If camera is behind Manaka, check HipCrouch
				# Log("FC.CR:  << Facing passed, checking condition : _HipCrouch " + viewCurrent.front)
				if taggedHipCrouch > 0 
					if _state.Crouching || _state.Coat.Dropped || conVisPose.Check() || conGroin.Check()  # There are a lot of edge cases where HipCrouch SHOULD be visible, that we can't accurately check for, so we account for extra opportunities
						# Log("FC.CR:  <<< Visible : _HipCrouch : _state.Crouching || _state.Coat.Dropped || conVisPose.Check() || conGroin.Check(): " + viewCurrent.crotch)
						vis=Max( (viewCurrent.crotch*cBonus), (Abs(viewCurrent.front*cBonus)-modifiedFacingThreshold) )#HipCrouch Vis: Highest of crotch focus or facing
						cVis=Max(vis,cVis)
					else
						cNotVis+=visFlatPenalty
						# Log("FC.CR:  <<< Not visible : _HipCrouch : _state.Crouching || _state.Coat.Dropped || _state.Coat.Back  : " + viewCurrent.crotch)
			# Hip
			if viewCurrent.front > -modifiedFacingThreshold && (conBreast.Check() || Find("Vis_Pose", conString) >= 0 ) # If camera is in front of manaka and front is also exposed
				# Log("FC.CR:  < Facing towards/away from camera, checking for condition : _Hip : " + viewCurrent.front)
				if taggedHip > 0 
					# Log("FC.CR:  << Hip in focus, front is exposed, and facing towards : _Hip : " + viewCurrent.crotch)
					vis=(viewCurrent.crotch + Abs(viewCurrent.front*cBonus)-modifiedFacingThreshold)/2 *cBonus #Hip Vis: average of facing camera focus	
					cVis=Max(vis,cVis)
								# Visibility Futa
			elseif viewCurrent.front > modifiedFacingThreshold && (conGroin.Check() || Find("Vis_Pose", conString)  >= 0 ) # If camera is behind manaka and butt is exposed
				if taggedHip > 0
					# Log("FC.CR:  << Hip in focus, rear is exposed, and facing away : _Hip : " + viewCurrent.crotch)
					vis=(viewCurrent.crotch + Abs(viewCurrent.front*cBonus)-modifiedFacingThreshold)/2 *cBonus #Hip Vis: average of facing and camera focus	
					cVis=Max(vis,cVis)
			elseif taggedHip > 0  # Camera must be side-view to get this far, then check for Hip conditions only to penalise visibility
				cNotVis+=visFlatPenalty
				# Log("FC.CR:  << Facing failed : _HipCrouch,_Hip : viewCurrent.front : " + viewCurrent.front)
				# Log("FC.CR:  << Facing failed : _HipCrouch,_Hip : modifiedFacingThreshold : " + modifiedFacingThreshold)

			# Visibility Futa
			if taggedFuta>0 && viewCurrent.front>-0.33 && viewCurrent.side <0.66
				vis=Min(viewCurrent.crotch,viewCurrent.front)*2*cBonus
				cVis=Max(vis,cVis)

		# Visibility Face
		face = Max(viewCurrent.face, (viewCurrent.face + Min(0,viewCurrent.front))/2 )
		if face > -cAngleBonus
			if Find("Vis_Face",conString) >= 0
				vis=face # Do not use the other bonusses or penalties for the head
				cVis=Max(vis,cVis)

		# Log("FC.CR:  Visibility for " +conString+ ", cNotvis: "+cNotVis+", cVis: "+cVis)
		cVis-=cNotVis # Apply low visibility penalties
	else # The condition does not include "Expose" or "Vis, then exposure is not a requirement, so visibility=1 for scoring purposes
		cVis = 1

	cVis=Max(0,cVis)
	cVis *= npcVis.focus
	Log("FC.CR:  Visibility for " +conString+ ", cVis:"+cVis+" cNotVis:"+cNotVis+" npcVis.focus:"+npcVis.focus)
	_result = cVis



## SPECIAL CONDITIONS
#The following unique subconditions are meant to be used for logic filtering etc without triggering the default visibilty checks that occur for "Exposed_" keywords

# Camera check
conFP=CreateCondition("FPCamera")
# SubCondition_None. An object useful for quick exposure check -  conNone.Check() 
conNone=CreateCondition("Exposed_None", id="None")
conVisible=CreateCondition("!Invisible", id="Visible")
# SubCondition_Exposed_Any : ultimately this is inverse of conNone
conExposedAny=CreateCondition("(!Exposed_None,[Crouching,Exposed_HipCrouch])", id="Exposed_Any")
# SubCondition_NotAll : Omits Exposed keyword to avoid affecting visibility
conNotAll=CreateCondition("(!Exposed_None,!Exposed_All)", id="NotAll")

# SubCondition_Coat_Open : check for any difference from default coat state
conCoatOpen=CreateCondition("(CoatDropped,CoatFrontOpen1,CoatFrontOpen2,CoatBackOpen)", id="Coat_Open")

## VISIBILITY
# SubCondition_Vis_Naked : only if VISIBLY naked 
conNaked=CreateCondition("[CoatDropped,Exposed_All,!Bodypaint,!Invisible]", id="Vis_Naked")
# SubCondition_Vis_Pose : a shortcut to help detect if Manaka is posing. No algorithm is suitable for all poses/actions, so a flat bonus is given - better than nothing?
conVisPose=CreateCondition("[!Action_None,!HandcuffsBack,!Moving,!Crouching,!Sitting]", id="Vis_Pose")
# SubCondition_Vis_Groin :
conGroin=CreateCondition("(Exposed_HipCrouch,Exposed_Hip,!Action_None)", id="Vis_Groin")
# SubCondition_Vis_Breast :
conBreast=CreateCondition("[(CoatDropped,CoatFrontOpen1,CoatFrontOpen2),(Exposed_Front,Exposed_Upper,SubCondition_Vis_Pose)]", id="Vis_Breast")
# SubCondition_Vis_NPC :
conVisNPC=CreateCondition("(ShowingOff,[Watched,NearNPC])", id="Vis_NPC")

