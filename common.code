contains:
	list = _args[0]
	id = _args[1]

	i = list.Count()

	_result = false

	while i > 0
		i = i - 1
		if list[i] == id
			_result = true
			i = 0

lerp:
	x = _args[0]
	y = _args[1]
	a = _args[2]
	_result = x * (1 - a) + y * a