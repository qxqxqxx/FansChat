fanschat_route_new_hunter_listener:
	if Global("fanschat_need_route_hunter") == true
		#Log("FC.HC:  route listener active")

		id = Global("fanschat_last_hunter_id")
		targetStage = Global("fanschat_target_stage")
		targetX = Global("fanschat_target_x")
		targetY = Global("fanschat_target_y")
		targetZ = Global("fanschat_target_z")

		if id != null && targetStage != null
			targetPos = CreateList(stage=targetStage, x=targetX, y=targetY, z=targetZ)

			#Log("FC.HC:  try route hunter id=" + id)

			npc = CreateNPC(id)
			if npc != null
				#Log("FC.HC:  route only this hunter id=" + id)
				npc.ClearWaypoints()
				npc.AddWaypoint(targetPos)
				npc.Stopped(false)

				routeMsg = get_hunter_route_msg_list()
				chat.Add(routeMsg[RandomInt(0, routeMsg.Count())], "Left", silent=false)
				sndChatNotify.Play(0.25)
				PlaySoundEffect("MentalAlert", 0.5)

				Global("fanschat_need_route_hunter", false)
			else
				#Log("FC.HC:  npc not ready yet id=" + id)
		else
			#Log("FC.HC:  route data missing | id=" + id + " stage=" + targetStage)
			Global("fanschat_need_route_hunter", false)


fanschat_spawn_listener:
	ev = GetEvent("fanschat_spawn_hunter")
	if ev != null
		#Log("FC.HC:  spawn event received")
		if _time - _save.lastFanschatHunterSpawn > 3
			pos = ev.position

			if pos != null
				#Log("FC.HC:  spawn position ok")
				#Log(Format("FansChat: spawn hunter | stage={0} | level={1} | anon={2:F2}", ev.area, ev.level, ev.anon))
				#Log("FC.HC:  about to add hunter")
				SetEvent("hunted_add_hunter", CreateList(source="FansChat", avatar_type="NewMale", position=pos))
				#Log("FC.HC:  add hunter event sent")
				_save.lastFanschatHunterSpawn = _time
			else
				#Log("FC.HC:  spawn skipped, position is null")
		else
			#Log("FC.HC:  spawn skipped, cooldown")


if Global("fanschat_hunter_watch_thread") == null
	Global("fanschat_hunter_watch_thread", CreateThread("fanschat_hunter_watch_main"))

fanschat_hunter_watch_main:
	thread = _this
	listener = CreateListener("fanschat_hunter_watch_listener")

fanschat_hunter_watch_listener:
	res = GetEvent("hunted_hunter_added")
	if res != null
		res = res[0]
		#Log("FC.HC:  hunted_hunter_added received")
		#Log("FC.HC:  added source=" + res.source)
		if res.source == "FansChat"
			#Log("FC.HC:  hunter added id=" + res.id + " stage=" + res.position.stage)

	res = GetEvent("hunted_hunter_removed")
	if res != null
		i = res.Count()
		while i > 0
			i -= 1
			res_info = res[i]
			#Log("FC.HC:  hunter removed id=" + res_info.id)
			

get_hunter_spawn_pos:
	minDist = hunter_spawnDistAvg/2
	maxDist = hunter_spawnDistAvg + (hunter_spawnDistAvg/2)
	tryCount = 12
	bestPos = null
	bestDist = 999999

	i = 0
	while i < tryCount
		pos = GetRandomPosition(minDist)
		if pos != null
			dist = Vector3Distance(_state.Position, pos)

			if dist >= minDist && dist <= maxDist
				_result = pos
				return

			if dist < bestDist
				bestDist = dist
				bestPos = pos
		i = i + 1

	if bestPos != null
		_result = bestPos
	else
		_result = _state.Position
